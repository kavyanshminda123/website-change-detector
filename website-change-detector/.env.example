PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/monitor.db
SNAPSHOT_DIR=./data/snapshots
# Optional Redis if you later want a distributed queue. Local mode uses SQLite queue.
REDIS_URL=
# Optional email alerts (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
# Optional Telegram bot
TELEGRAM_BOT_TOKEN=
# Public channel/chat ID or destination
TELEGRAM_CHAT_ID=
# Optional default webhook URL (Discord or any compatible webhook)
DEFAULT_WEBHOOK_URL=
# Security: set a long random value for the dashboard session cookie signing key
SESSION_SECRET=replace-this-with-a-long-random-secret
